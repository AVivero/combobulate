{
  "name": "combobulate",
  "version": "0.0.0",
  "description": "The headless toolkit for accessible, virtualized autocompletes.",
  "license": "MIT",
  "keywords": ["autocomplete", "combobox", "headless", "virtualized", "accessible", "react"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexvivero/combobulate.git"
  },
  "homepage": "https://github.com/alexvivero/combobulate#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "workspaces": ["examples/*"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "bun --cwd=examples/playground run dev",
    "e2e": "playwright test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@tanstack/react-virtual": ">=3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@happy-dom/global-registrator": "^15.11.0",
    "@playwright/test": "^1.61.1",
    "@tanstack/react-virtual": "^3.10.9",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
