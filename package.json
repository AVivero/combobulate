{
  "name": "combobulate",
  "version": "0.1.0",
  "description": "The headless toolkit for accessible, virtualized autocompletes.",
  "license": "MIT",
  "keywords": ["autocomplete", "combobox", "headless", "virtualized", "accessible", "react"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexvivero/combobulate.git"
  },
  "homepage": "https://github.com/alexvivero/combobulate#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "check:packaging": "publint && attw --pack",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ariakit/components": "0.1.10",
    "@ariakit/react": "~0.4.37",
    "@ariakit/store": "0.1.8",
    "@floating-ui/react": "^0.27",
    "@tanstack/react-virtual": "~3.14.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^1.9.4",
    "@happy-dom/global-registrator": "^15.11.0",
    "@playwright/test": "^1.61.1",
    "@storybook/react": "^8",
    "@storybook/react-vite": "^8",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "publint": "^0.3.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^5"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
