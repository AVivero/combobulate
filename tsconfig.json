{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["bun", "react", "react-dom"]
  },
  "include": [
    "src",
    "examples",
    "test-setup.ts",
    "tsup.config.ts",
    "e2e",
    "playwright.config.ts",
    ".storybook"
  ]
}
